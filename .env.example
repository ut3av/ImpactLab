# Application environment: development | production | test
APP_ENV=development

# Cerebras inference (optional). Leave empty to run without live AI explanations.
# Keep this server-side only. Never prefix with VITE_.
CEREBRAS_API_KEY=
# Model id from https://inference-docs.cerebras.ai/models/overview (e.g. llama3.1-70b, gpt-oss-120b)
CEREBRAS_MODEL=gpt-oss-120b
# Seconds before an AI request is abandoned (deterministic answer is shown instead)
CEREBRAS_TIMEOUT_S=20
# Port to bind (platforms such as Render set this automatically via $PORT)
PORT=8000

